# /etc/apparatus/agentd.env on the user VM. Written by the VM startup script from
# instance metadata (vm_id, user_id, server_url). No secrets beyond the enrollment file.
AGENTD_SERVER_URL=wss://api.example.com/ws/agentd
AGENTD_VM_ID=apparatus-u-1234abcd
AGENTD_USER_ID=firebase-uid
AGENTD_LOG_LEVEL=INFO
