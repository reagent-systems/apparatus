{
  "name": "apparatus-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Thin web client: audio, voice gate, feed, show pane, VM screen. React 19, Vite, Tailwind, shadcn/ui.",
  "scripts": {
    "dev": "vite",
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test test/*.test.ts",
    "gate-vectors": "node scripts/gate-vectors.ts",
    "verify": "npm run typecheck && npm run build && npm test"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.6.0",
    "vite": "^8.3.3"
  },
  "dependencies": {
    "@apparatus/design": "*",
    "@apparatus/orb": "*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.52.0",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-resizable-panels": "^4.14.3",
    "tailwind-merge": "^3.7.0"
  }
}
