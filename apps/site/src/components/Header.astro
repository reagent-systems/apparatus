---
import Icon from "./Icon.astro";
import { REPO } from "../lib/links.ts";
import GithubMark from "./GithubMark.astro";
import Mark from "./Mark.astro";

const nav = [
  { href: "/#computer", label: "Cloud computer" },
  { href: "/#devices", label: "Devices" },
  { href: "/#safety", label: "Safety" },
  { href: "/#how-it-works", label: "How it works" },
  { href: "/#run", label: "Run it" },
];
---

<header class="sticky top-0 z-40 bg-background/80 backdrop-blur-md supports-[backdrop-filter]:bg-background/70">
  <div class="mx-auto flex h-16 max-w-[1200px] items-center gap-3 px-4 min-[360px]:gap-6 sm:px-6 lg:px-8">
    <a href="/" class="-ml-1 flex items-center gap-2.5 rounded-md px-1 text-[0.9375rem] font-medium" aria-label="apparatus, home">
      <Mark size={22} />
      <span>apparatus</span>
    </a>
    <nav aria-label="Sections" class="ml-4 hidden lg:block">
      <ul class="flex items-center gap-1 text-sm whitespace-nowrap text-muted-foreground">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} class="rounded-full px-3 py-1.5 transition-colors duration-150 ease-ui hover:bg-secondary hover:text-foreground">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="ml-auto flex items-center gap-1.5">
      <button
        type="button"
        data-theme-toggle
        aria-pressed="false"
        aria-label="Dark theme"
        class="grid size-9 place-items-center rounded-full text-muted-foreground transition-colors duration-150 ease-ui hover:bg-secondary hover:text-foreground"
      >
        <Icon name="Moon" class="size-[18px] dark:hidden" strokeWidth={1.5} />
        <Icon name="Sun" class="hidden size-[18px] dark:block" strokeWidth={1.5} />
      </button>
      <a
        href={REPO}
        aria-label="apparatus on GitHub"
        class="flex h-9 items-center gap-2 rounded-full bg-secondary px-2.5 text-sm min-[360px]:px-4 font-medium text-foreground transition-colors duration-150 ease-ui hover:bg-accent hover:text-accent-foreground"
      >
        <GithubMark />
        <span class="max-[359px]:sr-only">GitHub</span>
      </a>
    </div>
  </div>
</header>
