---
interface Props {
  id: string;
  eyebrow: string;
  title: string;
  class?: string;
}
const { id, eyebrow, title, class: className } = Astro.props;
---

<section id={id} aria-labelledby={`${id}-title`} class:list={["mx-auto w-full max-w-[1200px] px-4 py-16 sm:px-6 md:py-24 lg:px-8", className]}>
  <div class="max-w-[46rem]">
    <p class="eyebrow">{eyebrow}</p>
    <h2 id={`${id}-title`} class="mt-4 text-title font-medium text-balance">{title}</h2>
    <slot name="lede" />
  </div>
  <slot />
</section>
