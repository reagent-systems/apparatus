---
import Section from "./Section.astro";
import Video from "./Video.astro";

const steps = [
  { title: "You talk", body: "Tap the orb and say what you need. There is no text box for requests and no button to hold." },
  {
    title: "It works",
    body: "The request becomes a job on your cloud computer. The voice keeps talking with you while the job runs.",
  },
  { title: "It shows you", body: "The result lands in the feed: what it found, a table, the file it made." },
  {
    title: "It asks only when a person must act",
    body: "It is told to stop for an approval, a sign-in or a captcha, and to do the rest without you.",
  },
];
---

<Section id="how-it-feels" eyebrow="How it feels" title="You talk. It works. It shows you.">
  <div class="mt-14 grid items-start gap-12 lg:grid-cols-[minmax(0,6fr)_minmax(0,5fr)] lg:gap-16">
    <ol class="grid gap-9">
      {
        steps.map((step, i) => (
          <li class="grid gap-y-2 sm:grid-cols-[2rem_1fr] sm:gap-x-4">
            <span class="pt-0.5 font-sans text-[0.8125rem] font-medium text-primary tabular-nums">{String(i + 1).padStart(2, "0")}</span>
            <div>
              <h3 class="text-lg font-medium">{step.title}</h3>
              <p class="mt-2 max-w-[34rem] leading-relaxed text-pretty text-muted-foreground">{step.body}</p>
            </div>
          </li>
        ))
      }
    </ol>
    <!-- The loop draws its own bezel (48 px corners at 1.2x); the radius trims the page-coloured corners outside it. -->
    <figure class="mx-auto w-[min(78vw,320px)] lg:sticky lg:top-24">
      <Video
        name="phone"
        dark="phone-dark"
        label="The web app at phone size: a spoken request becomes a job, then the Weekly orders table"
        class="[border-radius:11.7%/5.55%] dark:ring-1 dark:ring-white/12"
      />
      <figcaption class="mt-4 text-center text-[0.8125rem] text-pretty text-muted-foreground">
        The web app at phone size in a browser, in a drawn frame. Demo mode, with a scripted voice.
      </figcaption>
    </figure>
  </div>
</Section>
