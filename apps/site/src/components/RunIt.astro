---
import Icon from "./Icon.astro";
import { GCP, LOCAL, REPO, SETUP, STATUS } from "../lib/links.ts";
import Section from "./Section.astro";

const commands = [
  `git clone ${REPO}.git && cd apparatus`,
  "cp .env.example .env",
  "docker compose -f infra/local/docker-compose.yml up --build",
];
// A line may break only after a "/" or a "-", so a path never splits mid-word on a phone.
const parts = (c: string) => c.split(/(?<=[/-])/);
const docs = [
  { href: SETUP, title: "Setup docs", body: "Run the server and agentd on your machine, with or without Docker." },
  { href: LOCAL, title: "The local compose file", body: "The server and a cloud computer stand-in with a virtual desktop." },
  { href: GCP, title: "Deploy to Google Cloud", body: "Terraform for Cloud Run, one VM per person, and a TURN relay." },
];
const code = "font-mono text-[0.875rem] text-foreground";
---

<Section id="run" eyebrow="Run it yourself" title="The code is on GitHub. Run it on your machine.">
  <p slot="lede" class="mt-6 text-lede text-pretty text-muted-foreground">
    The server, the cloud computer's daemon, every client and the Terraform for Google Cloud are in one repository.
    Locally, the path is three commands that build the server and a virtual desktop in Docker.
  </p>

  <div class="mt-12">
    <div class="frame">
      <div class="flex justify-end pt-3 pr-3">
        <button
          type="button"
          data-copy="run-commands"
          aria-label="Copy the commands"
          class="group grid size-9 place-items-center rounded-full text-muted-foreground transition-colors duration-150 ease-ui hover:bg-background hover:text-foreground"
        >
          <Icon name="Copy" class="size-4 group-data-copied:hidden" strokeWidth={1.5} />
          <Icon name="Check" class="hidden size-4 text-status-ok group-data-copied:block" strokeWidth={1.75} />
        </button>
      </div>
      <!-- The lines wrap with a hanging indent at a "/" or a "-", so nothing scrolls sideways on a phone. -->
      <pre
        id="run-commands"
        class="-mt-4 px-5 pb-6 font-mono text-[0.8125rem] leading-7 whitespace-pre-wrap break-normal [overflow-wrap:normal] sm:-mt-2 sm:px-7 sm:text-sm"><code>{commands.map((c) => <span class="block pr-10 pl-4 -indent-4" data-command={c}><span class="select-none text-muted-foreground">$ </span>{parts(c).map((p) => <>{p}<wbr /></>)}</span>)}</code></pre>
    </div>
    <p class="mt-5 max-w-[56rem] text-[0.9375rem] leading-relaxed text-pretty text-muted-foreground">
      Then open <code class={code}>http://localhost:8080</code>.{" "}
      Put a <code class={code}>GEMINI_API_KEY</code> in <code class={code}>.env</code>; without one the voice does not
      connect and every job fails.{" "}
      Add <code class={code}>APPARATUS_DEMO=1</code> to <code class={code}>.env</code> to run scripted jobs without a key.
    </p>
    <!-- A distinct note, not an <aside>: a complementary landmark inside a section fails axe's landmark rule. -->
    <div class="mt-6 max-w-[56rem] rounded-xl bg-secondary px-5 py-4 text-[0.9375rem] leading-relaxed text-pretty text-muted-foreground">
      <p class="font-medium text-foreground">Where it stands</p>
      <p class="mt-1">
        apparatus is early. The server and agentd run end to end in tests, against fakes and real Python kernels. It has
        not yet run a live session with Gemini on a real cloud computer, and no app has run on a phone or a watch. The
        Docker path has not been run end to end yet. The Google Cloud Terraform passes <code class={code}>terraform validate</code>{" "}
        but has not been applied to a real project. <a class="link" href={STATUS}>The status page</a> has the rest.
      </p>
    </div>
  </div>
  <ul class="mt-12 grid gap-2 md:grid-cols-3 md:gap-x-10 md:gap-y-5">
    {
      docs.map((d) => (
        <li>
          <a
            href={d.href}
            class="group -mx-3 flex h-full items-start gap-4 rounded-xl px-3 py-4 transition-colors duration-150 ease-ui hover:bg-secondary md:-mx-5 md:px-5 md:py-5"
          >
            <span class="flex-1">
              <span class="block font-medium">{d.title}</span>
              <span class="mt-1 block text-[0.9375rem] leading-relaxed text-muted-foreground">{d.body}</span>
            </span>
            <Icon name="ArrowUpRight" class="mt-0.5 size-4 shrink-0 text-muted-foreground transition-transform duration-150 ease-ui group-hover:translate-x-0.5 group-hover:-translate-y-0.5" strokeWidth={1.5} />
          </a>
        </li>
      ))
    }
  </ul>
</Section>
