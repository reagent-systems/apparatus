---
import { markDots } from "../lib/mark.ts";

interface Props {
  size?: number;
  class?: string;
}
const { size = 22, class: className } = Astro.props;
const dots = markDots();
---

<svg width={size} height={size} viewBox="0 0 32 32" class={className} aria-hidden="true" fill="currentColor">
  {dots.map((d) => <circle cx={d.x} cy={d.y} r={d.r} fill-opacity={d.o} />)}
</svg>
