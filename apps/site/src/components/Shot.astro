---
// A still from docs/media as responsive WebP, with its dark twin swapped in by the theme.
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  src: ImageMetadata;
  dark?: ImageMetadata;
  alt: string;
  widths: number[];
  sizes: string;
  class?: string;
}
const { src, dark, alt, widths, sizes, class: className } = Astro.props;
// Lazy: an image under display:none never loads, so only the theme's own twin is fetched.
---

<Image
  src={src}
  alt={alt}
  widths={widths}
  sizes={sizes}
  format="webp"
  quality={80}
  loading="lazy"
  class:list={["block h-auto w-full", dark && "dark:hidden", className]}
/>
{
  dark && (
    <Image
      src={dark}
      alt={alt}
      widths={widths}
      sizes={sizes}
      format="webp"
      quality={80}
      loading="lazy"
      class:list={["hidden h-auto w-full dark:block", className]}
    />
  )
}
