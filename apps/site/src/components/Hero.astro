---
import heroPhoneDark from "../assets/crops/hero-phone-dark.png";
import heroPhone from "../assets/crops/hero-phone.png";
import heroDark from "@media/hero-dark.png";
import heroLight from "@media/hero-light.png";
import type { ImageMetadata } from "astro";
import Icon from "./Icon.astro";
import { getImage } from "astro:assets";
import { MEDIA_README, REPO, STATUS } from "../lib/links.ts";
import { ORB_STEPS } from "../lib/orb-steps.ts";
import GithubMark from "./GithubMark.astro";
import OrbStill from "./OrbStill.astro";

// The hero's states: the page opens on the dotted sphere listening. Off is in
// the orb section's state sheet; its ring of dashes would read as a spinner here.
const steps = ORB_STEPS.filter((s) => s.name !== "off");

// One <picture> for both themes, so the first screen's largest image loads
// eagerly and once: the dark sources follow the system, and lib/client.ts
// points them at the page's theme when the viewer picks one. Under 640 px the
// phone and the watch alone, at a legible size. From xl the figure leaves the
// 1200 px column, so the desktop window draws large enough to read.
const sizes = "(min-width: 1440px) 1336px, (min-width: 640px) calc(100vw - 64px), calc(100vw - 32px)";
const narrowSizes = "calc(100vw - 32px)";
const wide = (src: ImageMetadata) => getImage({ src, widths: [640, 960, 1280, 1920, 2752], sizes, format: "webp", quality: 80 });
const narrow = (src: ImageMetadata) => getImage({ src, widths: [360, 720, 1080], sizes: narrowSizes, format: "webp", quality: 80 });
const [wideLight, wideDark, narrowLight, narrowDark] = await Promise.all([
  wide(heroLight),
  wide(heroDark),
  narrow(heroPhone),
  narrow(heroPhoneDark),
]);
const NARROW = "(max-width: 639px)";
---

<section aria-labelledby="hero-title" class="relative">
  <div
    class="mx-auto flex max-w-[1200px] flex-col items-center px-4 pt-8 text-center sm:px-6 md:pt-10 lg:grid lg:grid-cols-[minmax(0,6fr)_minmax(0,5fr)] lg:items-center lg:gap-12 lg:px-8 lg:pt-16 lg:text-left"
  >
    <!-- First in the DOM, as it is first on a phone; from lg it moves right. -->
    <div class="flex flex-col items-center gap-4 lg:order-2" data-orb-hero>
      <div class="relative aspect-square w-[min(72vw,320px)] lg:w-[min(36vw,460px)]" data-orb role="img" aria-label="The orb, the one control of apparatus">
        <OrbStill animation={steps[0]!.animation} eager />
      </div>
      <div role="group" aria-label="Orb states" class="flex items-center gap-1 text-[0.8125rem]">
        {
          steps.map((s, i) => (
            <button
              type="button"
              data-orb-chip={s.name}
              aria-pressed={i === 0 ? "true" : "false"}
              class="rounded-full px-3 py-1 text-muted-foreground transition-colors duration-200 ease-ui hover:bg-secondary hover:text-foreground aria-pressed:bg-accent aria-pressed:text-accent-foreground"
            >
              {s.label}
            </button>
          ))
        }
        <button
          type="button"
          data-motion-toggle
          aria-pressed="false"
          aria-label="Pause motion"
          class="group ml-1 grid size-7 place-items-center rounded-full text-muted-foreground transition-colors duration-150 ease-ui hover:bg-secondary hover:text-foreground"
        >
          <Icon name="Pause" class="size-4 group-aria-pressed:hidden" strokeWidth={1.5} />
          <Icon name="Play" class="hidden size-4 group-aria-pressed:block" strokeWidth={1.5} />
        </button>
      </div>
    </div>

    <div class="flex flex-col items-center lg:order-1 lg:items-start">
      <h1 id="hero-title" class="mt-8 max-w-[13ch] text-display font-medium text-balance lg:mt-0">
        A voice agent with its own cloud computer
      </h1>
      <p class="mt-5 max-w-[36rem] text-lede text-pretty text-muted-foreground">
        You talk. It does the work on a Linux desktop of its own, shows you the result, and asks only when a person must
        act.
      </p>
      <div class="mt-8 flex w-full flex-col items-stretch gap-3 sm:w-auto sm:flex-row sm:items-center">
        <a
          href={REPO}
          class="flex h-12 items-center justify-center gap-2.5 rounded-full bg-primary px-6 text-[0.9375rem] font-medium text-primary-foreground transition-opacity duration-150 ease-ui hover:opacity-90"
        >
          <GithubMark />
          Get the code
        </a>
        <a
          href="#run"
          class="group flex h-12 items-center justify-center gap-2 rounded-full px-6 text-[0.9375rem] font-medium transition-colors duration-150 ease-ui hover:bg-secondary"
        >
          Run it yourself
          <Icon name="ArrowRight" class="size-4 transition-transform duration-150 ease-ui group-hover:translate-x-0.5" strokeWidth={1.75} />
        </a>
      </div>
      <p class="mt-6 text-[0.8125rem] text-pretty text-muted-foreground">Web, Windows, macOS, Linux, iPhone, Android, Apple Watch, Wear OS</p>
      <p class="mt-2 max-w-[36rem] text-[0.8125rem] text-pretty text-muted-foreground">
        apparatus is early: it has not yet run with Gemini on a real cloud computer. <a class="link" href={STATUS}>Where it stands</a>.
      </p>
    </div>
  </div>

  <figure class="mx-auto mt-12 max-w-[1200px] px-4 sm:px-6 lg:mt-14 lg:px-8 xl:max-w-[1400px]">
    <picture class="block">
      <source
        media={`${NARROW} and (prefers-color-scheme: dark)`}
        data-dark-media={NARROW}
        srcset={narrowDark.srcSet.attribute}
        sizes={narrowSizes}
        width={heroPhoneDark.width}
        height={heroPhoneDark.height}
        type="image/webp"
      />
      <source media={NARROW} srcset={narrowLight.srcSet.attribute} sizes={narrowSizes} width={heroPhone.width} height={heroPhone.height} type="image/webp" />
      <source
        media="(prefers-color-scheme: dark)"
        data-dark-media="all"
        srcset={wideDark.srcSet.attribute}
        sizes={sizes}
        width={heroDark.width}
        height={heroDark.height}
        type="image/webp"
      />
      <img
        src={wideLight.src}
        srcset={wideLight.srcSet.attribute}
        sizes={sizes}
        width={heroLight.width}
        height={heroLight.height}
        alt="The desktop app listening, with what the model heard above the orb; a phone on a job's receipt; the Wear OS app listening"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="hero-fade block h-auto w-full"
      />
    </picture>
    <!-- The caption keeps to the page column, though the picture is wider from xl. -->
    <figcaption class="mx-auto mt-4 max-w-[1136px] text-center text-[0.8125rem] text-pretty text-muted-foreground lg:text-left">
      Real captures of the app in demo mode, with a scripted voice. The hero puts 3 separate captures side by side.{" "}
      <a class="link" href={MEDIA_README}>How they were made</a>.
    </figcaption>
  </figure>
</section>
