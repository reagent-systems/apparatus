---
import { ORB_STEPS } from "../lib/orb-steps.ts";
import OrbStill from "./OrbStill.astro";
import Section from "./Section.astro";
---

<Section id="orb" eyebrow="The orb" title="One control, and it is the orb.">
  <p slot="lede" class="mt-6 text-lede text-pretty text-muted-foreground">
    Tap it to start. Tap it again to hang up, like a phone call. To interrupt the agent, talk over it. Above the orb, the
    screen shows what the model heard you say. Listening, working and speaking each move differently, and a running job
    shows a small orb of its own. The microphone is open while the agent is on; a voice gate on your device sends only
    speech.
  </p>
  <!-- The state sheet: each state live, side by side. lib/orb.ts draws every [data-orb-static] host. -->
  <ul class="mt-14 grid grid-cols-2 gap-x-6 gap-y-10 lg:grid-cols-4">
    {
      ORB_STEPS.map((s) => (
        <li class="flex flex-col items-center">
          <div class="relative aspect-square w-full max-w-[220px]" data-orb-static={s.name} role="img" aria-label={`The orb, ${s.label.toLowerCase()}`}>
            <OrbStill animation={s.animation} />
          </div>
          <p class="mt-4 text-[0.8125rem] text-muted-foreground">{s.label}</p>
        </li>
      ))
    }
  </ul>
</Section>
