---
import Closing from "../components/Closing.astro";
import Desktop from "../components/Desktop.astro";
import Devices from "../components/Devices.astro";
import Feels from "../components/Feels.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import HowItWorks from "../components/HowItWorks.astro";
import Orb from "../components/Orb.astro";
import RunIt from "../components/RunIt.astro";
import Safety from "../components/Safety.astro";
import Waitlist from "../components/Waitlist.astro";
import Base from "../layouts/Base.astro";
---

<Base
  title="apparatus: a voice agent with its own cloud computer"
  description="You talk while apparatus works on its cloud computer, a Linux desktop with a Python session per job, shell commands and Chromium. It is told to ask before it sends, buys or deletes. Open source under MIT: you run it yourself, with your own Gemini API key."
>
  <Header />
  <main id="main" tabindex="-1">
    <Hero />
    <Feels />
    <Orb />
    <Desktop />
    <Devices />
    <Safety />
    <HowItWorks />
    <RunIt />
    <Waitlist />
    <Closing />
  </main>
  <Footer />
</Base>
