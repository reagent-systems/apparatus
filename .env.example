# Copy to .env for local development. Never commit .env.

# Gemini API key. Only the session server reads it. It never enters a VM.
GEMINI_API_KEY=

# Path to the single config file.
APPARATUS_CONFIG=config/apparatus.toml

# Server bind.
APPARATUS_HOST=0.0.0.0
APPARATUS_PORT=8080

# Auth mode: dev | firebase. dev trusts the X-User-Id header. Use firebase for real users.
APPARATUS_AUTH_MODE=dev
# Firebase project id, used by the firebase auth mode to verify ID tokens.
FIREBASE_PROJECT_ID=

# Store adapter: memory | file. The file store writes JSON under APPARATUS_DATA_DIR.
APPARATUS_STORE=file
APPARATUS_DATA_DIR=data

# Shared enrollment secret for VMs. agentd presents HMAC(vm_id) over this secret.
# Rotate it when a VM image leaks. It grants nothing but "this VM speaks for its user".
APPARATUS_VM_ENROLL_SECRET=change-me

# VM controller: local | gce
APPARATUS_VM_CONTROLLER=local
GCE_PROJECT=
GCE_ZONE=

# Push adapter: log | fcm
APPARATUS_PUSH=log

# agentd (runs on the VM)
AGENTD_SERVER_URL=ws://localhost:8080/ws/agentd
AGENTD_VM_ID=local
AGENTD_USER_ID=dev
AGENTD_HOME=/home/agent
AGENTD_DESKTOP=fake
